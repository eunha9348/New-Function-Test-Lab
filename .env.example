# ── 필수 ────────────────────────────────────────────────
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
# 이 키 하나로 Gemini(분류·배분·감독·안내·이미지 OCR·음성 인식)가 전부 돕니다.
GOOGLE_API_KEY=

# ── 선택 ────────────────────────────────────────────────
# 모델을 고정하고 싶을 때 (비우면 ListModels로 최신 모델 자동 선택)
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_LIGHT_MODEL=gemini-2.5-flash

# Cloud Vision을 다른 키로 쓸 때만 (비우면 GOOGLE_API_KEY 사용)
# GOOGLE_VISION_API_KEY=

# 한국어 증명서 특화 OCR 보조 엔진 (선택)
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=

# 엔진을 Anthropic으로 바꿀 때만
# ARC_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
